{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-contact-form",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "shadowfox683@gmail.com",
      "allowed_sender_addresses": [
        "contact-form@johnbieniek.com"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTACT_DB",
      "database_name": "portfolio-contact-inquiries",
      "database_id": "6bb693e8-1f8a-4e3e-9daf-49252ff81a86",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CONTACT_QUEUE",
        "queue": "portfolio-contact-email"
      },
      {
        "binding": "CONTACT_DLQ",
        "queue": "portfolio-contact-email-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "portfolio-contact-email",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "portfolio-contact-email-dlq"
      },
      {
        "queue": "portfolio-contact-email-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "portfolio-contact-email-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://johnbieniek.com,https://www.johnbieniek.com,https://johns-portfolio.pages.dev,https://johns-portfolio-beta.pages.dev",
    "FROM_ADDRESS": "contact-form@johnbieniek.com",
    "TO_ADDRESS": "shadowfox683@gmail.com"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
